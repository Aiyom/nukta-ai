APP_NAME="Public AI Service"
ENVIRONMENT=local-docker
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

TEXT_BACKEND=mlx
TEXT_BACKEND_URL=http://host.docker.internal:8000/v1
TEXT_BACKEND_API_KEY=
TEXT_MODEL=mlx-community/Qwen3-8B-4bit

IMAGE_BACKEND=local_http
IMAGE_BACKEND_URL=http://host.docker.internal:8188
IMAGE_MODEL=runwayml/stable-diffusion-v1-5

VIDEO_BACKEND=mock
VIDEO_BACKEND_URL=http://host.docker.internal:8189

REQUEST_TIMEOUT_SECONDS=300
MAX_PROMPT_CHARS=120000
GENERATED_SITES_DIR=/app/generated_sites
