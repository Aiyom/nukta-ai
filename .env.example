APP_NAME="Public AI Service"
ENVIRONMENT=local
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Backends:
# - mock: no model, useful for app development
# - vllm: self-hosted OpenAI-compatible vLLM endpoint
# - llama_cpp: self-hosted llama.cpp server endpoint
# - mlx: self-hosted mlx_lm OpenAI-compatible server endpoint
TEXT_BACKEND=mock
TEXT_BACKEND_URL=http://127.0.0.1:8000/v1
TEXT_BACKEND_API_KEY=
TEXT_MODEL=mlx-community/Qwen3-8B-4bit

IMAGE_BACKEND=mock
IMAGE_BACKEND_URL=http://127.0.0.1:8188
IMAGE_MODEL=runwayml/stable-diffusion-v1-5

VIDEO_BACKEND=mock
VIDEO_BACKEND_URL=http://127.0.0.1:8189

REQUEST_TIMEOUT_SECONDS=180
MAX_PROMPT_CHARS=120000
GENERATED_SITES_DIR=../generated_sites
